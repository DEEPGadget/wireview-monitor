# systemd unit for wvd. From the repository root:
#   sudo python3 -m venv /opt/wvd && sudo /opt/wvd/bin/pip install "$PWD[server]"
#   sudo cp packaging/wvd.service /etc/systemd/system/ && sudo systemctl enable --now wvd
# Serial access comes from packaging/70-wireview.rules (0660 root:dialout).
# On Arch-based distros use SupplementaryGroups=uucp.
# wvd holds the port exclusively: stop scripts/up.sh, the official GUI and
# wireviewd first.
[Unit]
Description=WireView Pro II measurement daemon (API + dashboard)
After=network.target

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=dialout
StateDirectory=wvd
# Sockets between the wvd processes (recorder, api, front).
RuntimeDirectory=wvd
RuntimeDirectoryMode=0700
# Listens on all interfaces. Set a token to require auth for data access
# (needed anyway for WVD_ALLOW_WRITE=1), or bind 127.0.0.1 for local only:
#   Environment=WVD_TOKEN=change-me
Environment=WVD_HOST=0.0.0.0
Environment=WVD_PORT=8765
Environment=WVD_RATE=10
Environment=WVD_RETENTION=72h
ExecStart=/opt/wvd/bin/wvd
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-ttyACM rw

[Install]
WantedBy=multi-user.target
